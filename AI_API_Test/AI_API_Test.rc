/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
// Note: 아이콘 파일이 없는 경우 Visual Studio에서 자동 생성되거나
// 기본 아이콘이 사용됩니다. 필요시 res\AI_API_Test.ico 파일을 추가하세요.
// IDR_MAINFRAME           ICON                    "res\\AI_API_Test.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_AIAPI_TEST_DIALOG DIALOGEX 0, 0, 420, 500
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "AI API Tester"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    // 대화 내역 (최상단)
    LTEXT           "대화 내역:",IDC_STATIC_CHAT_LABEL,7,7,406,8
    CONTROL         "",IDC_RICHEDIT_CHAT,"RichEdit20W",ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_BORDER | WS_VSCROLL,7,18,406,250

    // 첨부 파일
    LTEXT           "첨부 파일:",IDC_STATIC_FILES_LABEL,7,273,406,8
    LISTBOX         IDC_LIST_FILES,7,284,406,60,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "추가",IDC_BTN_ADD_FILE,7,348,50,14
    PUSHBUTTON      "제거",IDC_BTN_REMOVE_FILE,62,348,50,14
    PUSHBUTTON      "모두제거",IDC_BTN_CLEAR_FILES,117,348,50,14

    // 프롬프트 입력 (4줄 이상)
    LTEXT           "프롬프트:",IDC_STATIC_PROMPT_LABEL,7,367,406,8
    EDITTEXT        IDC_EDIT_PROMPT,7,378,406,80,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON      "기본값 불러오기",IDC_BTN_LOAD_DEFAULT,7,463,80,14
    PUSHBUTTON      "지우기",IDC_BTN_CLEAR,305,463,50,14
    DEFPUSHBUTTON   "전송",IDC_BTN_SEND,360,463,53,14
END


